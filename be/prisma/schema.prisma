generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName                  String                    @map("full_name") @db.VarChar(150)
  email                     String                    @unique @db.VarChar(150)
  password                  String?                   @db.VarChar
  avatarFileId              String?                   @map("avatar_file_id") @db.Uuid
  emailVerified             Boolean                   @default(false) @map("email_verified")
  emailVerifiedAt           DateTime?                 @map("email_verified_at") @db.Timestamp(6)
  lastLoginAt               DateTime?                 @map("last_login_at") @db.Timestamp(6)
  isActive                  Boolean                   @default(true) @map("is_active")
  createdAt                 DateTime?                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime?                 @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt                 DateTime?                 @map("deleted_at") @db.Timestamp(6)
  departmentId              String?                   @map("department_id") @db.Uuid
  officeId                  String?                   @map("office_id") @db.Uuid
  department                Department?               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  officeLocation            OfficeLocation?           @relation(fields: [officeId], references: [id], onDelete: Restrict)
  activityLogs              ActivityLog[]
  trustedDevices            AttendanceDevice[]
  overriddenAttendances     AttendanceOverride[]
  resolvedViolations        AttendanceViolation[]
  auditLogs                 AuditLog[]
  generatedCertificates     Certificate[]             @relation("CertificateGeneratedBy")
  uploadedFiles             File[]                    @relation("FileUploadedBy")
  internProfile             InternProfile?
  reviewedApplications      InternshipApplication[]   @relation("ReviewedBy")
  changedInternshipStatuses InternshipStatusHistory[]
  readNotifications         NotificationRead[]
  sentNotifications         Notification[]            @relation("NotificationSender")
  refreshTokens             RefreshToken[]
  createdSupervisors        SupervisorAssignment[]    @relation("SupervisorAssignedBy")
  assignedSupervisors       SupervisorAssignment[]    @relation("SupervisorUser")
  assignedUserRoles         UserRole[]                @relation("UserRoleAssignedBy")
  userRoles                 UserRole[]                @relation("UserRoleUser")
  avatarFile                File?                     @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: Restrict)

  @@index([avatarFileId])
  @@map("users")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique @db.VarChar(50)
  name            String?          @db.VarChar(100)
  description     String?
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?        @updatedAt @map("updated_at") @db.Timestamp(6)
  rolePermissions RolePermission[]
  userRoles       UserRole[]       @relation("UserRoleRole")

  @@map("roles")
}

model UserRole {
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedAt   DateTime? @map("assigned_at") @db.Timestamp(6)
  assignedById String?   @map("assigned_by") @db.Uuid
  assignedBy   User?     @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  role         Role      @relation("UserRoleRole", fields: [roleId], references: [id])
  user         User      @relation("UserRoleUser", fields: [userId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String?          @unique @db.VarChar(100)
  name            String?          @db.VarChar
  description     String?
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  token     String?
  expiresAt DateTime? @map("expires_at") @db.Timestamp(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("refresh_tokens")
}

model EducationLevel {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String?       @unique @db.VarChar(20)
  name         String?       @db.VarChar(100)
  createdAt    DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  institutions Institution[]

  @@map("education_levels")
}

model Institution {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  educationLevelId  String?            @map("education_level_id") @db.Uuid
  name              String?            @db.VarChar(200)
  shortName         String?            @map("short_name") @db.VarChar(100)
  province          String?            @db.VarChar(100)
  logo              String?            @map("logo") 
  city              String?            @db.VarChar(100)
  createdAt         DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime?          @updatedAt @map("updated_at") @db.Timestamp(6)
  institutionMajors InstitutionMajor[]
  educationLevel    EducationLevel?    @relation(fields: [educationLevelId], references: [id], onDelete: Restrict)
  internProfiles    InternProfile[]

  @@index([educationLevelId])
  @@map("institutions")
}

model InstitutionMajor {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId  String?         @map("institution_id") @db.Uuid
  name           String?         @db.VarChar(150)
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  institution    Institution?    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  internProfiles InternProfile[]

  @@index([institutionId])
  @@map("institution_majors")
}

model Skill {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String?              @db.VarChar(100)
  category            String?              @db.VarChar(100)
  createdAt           DateTime?            @default(now()) @map("created_at") @db.Timestamp(6)
  internProfileSkills InternProfileSkill[]

  @@map("skills")
}

model Department {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique @db.VarChar(50)
  name            String?          @db.VarChar(150)
  description     String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?        @updatedAt @map("updated_at") @db.Timestamp(6)
  internships     Internship[]
  officeLocations OfficeLocation[]
  users           User[]

  @@map("departments")
}

model OfficeLocation {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String?             @db.VarChar(150)
  address            String?
  latitude           Decimal?            @db.Decimal
  longitude          Decimal?            @db.Decimal
  radiusMeter        Int?                @map("radius_meter")
  createdAt          DateTime?           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime?           @updatedAt @map("updated_at") @db.Timestamp(6)
  departments        Department[]
  attendanceSettings AttendanceSetting[]
  internships        Internship[]
  users              User[]

  @@map("office_locations")
}

model AttendanceSetting {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeLocationId String?         @map("office_location_id") @db.Uuid
  checkInStart     DateTime?       @map("check_in_start") @db.Time(6)
  checkInEnd       DateTime?       @map("check_in_end") @db.Time(6)
  checkOutStart    DateTime?       @map("check_out_start") @db.Time(6)
  checkOutEnd      DateTime?       @map("check_out_end") @db.Time(6)
  lateAfter        DateTime?       @map("late_after") @db.Time(6)
  allowWeekend     Boolean         @default(false) @map("allow_weekend")
  createdAt        DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime?       @updatedAt @map("updated_at") @db.Timestamp(6)
  officeLocation   OfficeLocation? @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)

  @@index([officeLocationId])
  @@map("attendance_settings")
}

model CertificateTemplate {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?       @db.VarChar(150)
  templateFileId String?       @map("template_file_id") @db.Uuid
  isDefault      Boolean?      @map("is_default")
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?     @updatedAt @map("updated_at") @db.Timestamp(6)
  templateFile   File?         @relation(fields: [templateFileId], references: [id], onDelete: Restrict)
  certificates   Certificate[]

  @@index([templateFileId])
  @@map("certificate_templates")
}

model InternProfile {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                  @unique @map("user_id") @db.Uuid
  studentNumber    String                  @map("student_number") @db.VarChar(100)
  institutionId    String                  @map("institution_id") @db.Uuid
  majorId          String                  @map("major_id") @db.Uuid
  phone            String                  @db.VarChar(30)
  emergencyContact String?                 @map("emergency_contact") @db.VarChar(30)
  address          String?
  birthPlace       String?                 @map("birth_place") @db.VarChar(100)
  birthDate        DateTime?               @map("birth_date") @db.Date
  gender           String?                 @db.VarChar(20)
  bio              String?
  createdAt        DateTime?               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime?               @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamp(6)
  profileSkills    InternProfileSkill[]
  institution      Institution             @relation(fields: [institutionId], references: [id])
  major            InstitutionMajor        @relation(fields: [majorId], references: [id])
  user             User                    @relation(fields: [userId], references: [id])
  applications     InternshipApplication[]
  internships      Internship[]

  @@index([institutionId])
  @@index([majorId])
  @@map("intern_profiles")
}

model InternProfileSkill {
  internProfileId String        @map("intern_profile_id") @db.Uuid
  skillId         String        @map("skill_id") @db.Uuid
  proficiency     String?       @db.VarChar(30)
  createdAt       DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  internProfile   InternProfile @relation(fields: [internProfileId], references: [id])
  skill           Skill         @relation(fields: [skillId], references: [id])

  @@id([internProfileId, skillId])
  @@index([skillId])
  @@map("intern_profile_skills")
}

model InternshipApplication {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internProfileId          String        @map("intern_profile_id") @db.Uuid
  applicationNumber        String?       @unique @map("application_number") @db.VarChar(100)
  introductionLetterFileId String        @map("introduction_letter_file_id") @db.Uuid
  requestedStartDate       DateTime?     @map("requested_start_date") @db.Date
  requestedEndDate         DateTime?     @map("requested_end_date") @db.Date
  motivation               String?
  /// Application status (ApplicationStatus) — enforced via TS enum in service layer.
  /// Allowed values: DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | RESUBMITTED
  /// Source: docs/05-state-machine.md §8, docs/04-business-rules.md §11
  status                   String?       @db.VarChar(50)
  reviewedById             String?       @map("reviewed_by") @db.Uuid
  reviewedAt               DateTime?     @map("reviewed_at") @db.Timestamp(6)
  rejectionReason          String?       @map("rejection_reason")
  createdAt                DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime?     @updatedAt @map("updated_at") @db.Timestamp(6)
  internProfile            InternProfile @relation(fields: [internProfileId], references: [id])
  introductionLetterFile   File          @relation("IntroductionLetterFile", fields: [introductionLetterFileId], references: [id])
  reviewedBy               User?         @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  internship               Internship?

  @@index([internProfileId])
  @@index([introductionLetterFileId])
  @@index([reviewedById])
  @@map("internship_applications")
}

model Internship {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId         String?                   @unique @map("application_id") @db.Uuid
  internProfileId       String?                   @map("intern_profile_id") @db.Uuid
  departmentId          String?                   @map("department_id") @db.Uuid
  officeLocationId      String?                   @map("office_location_id") @db.Uuid
  actualStartDate       DateTime?                 @map("actual_start_date") @db.Date
  actualEndDate         DateTime?                 @map("actual_end_date") @db.Date
  /// Internship status (InternshipStatus) — enforced via TS enum in service layer.
  /// Allowed values: ONBOARDING_PENDING | ONBOARDING_COMPLETED | ACTIVE | COMPLETED | CERTIFICATE_GENERATED | ARCHIVED
  /// Source: docs/05-state-machine.md §9, docs/04-business-rules.md §11
  status                String?                   @db.VarChar(50)
  onboardingCompleted   Boolean                   @default(false) @map("onboarding_completed")
  completedAt           DateTime?                 @map("completed_at") @db.Timestamp(6)
  createdAt             DateTime?                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime?                 @updatedAt @map("updated_at") @db.Timestamp(6)
  reminders             AttendanceReminder[]
  attendances           Attendance[]
  certificate           Certificate?
  statusHistories       InternshipStatusHistory[]
  application           InternshipApplication?    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  department            Department?               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  internProfile         InternProfile?            @relation(fields: [internProfileId], references: [id], onDelete: Restrict)
  officeLocation        OfficeLocation?           @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)
  onboardingHistories   OnboardingHistory[]
  supervisorAssignments SupervisorAssignment[]

  @@index([internProfileId])
  @@index([departmentId])
  @@index([officeLocationId])
  @@map("internships")
}

model SupervisorAssignment {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId String?     @map("internship_id") @db.Uuid
  supervisorId String?     @map("supervisor_id") @db.Uuid
  assignedById String?     @map("assigned_by") @db.Uuid
  assignedAt   DateTime?   @map("assigned_at") @db.Timestamp(6)
  endedAt      DateTime?   @map("ended_at") @db.Timestamp(6)
  isActive     Boolean     @default(true) @map("is_active")
  assignedBy   User?       @relation("SupervisorAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  internship   Internship? @relation(fields: [internshipId], references: [id], onDelete: Restrict)
  supervisor   User?       @relation("SupervisorUser", fields: [supervisorId], references: [id], onDelete: Restrict)

  @@index([internshipId])
  @@index([supervisorId])
  @@index([assignedById])
  @@map("supervisor_assignments")
}

model OnboardingHistory {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId String?     @map("internship_id") @db.Uuid
  accepted     Boolean?
  acceptedAt   DateTime?   @map("accepted_at") @db.Timestamp(6)
  ipAddress    String?     @map("ip_address") @db.VarChar(100)
  userAgent    String?     @map("user_agent")
  internship   Internship? @relation(fields: [internshipId], references: [id], onDelete: Restrict)

  @@index([internshipId])
  @@map("onboarding_histories")
}

model InternshipStatusHistory {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId String?     @map("internship_id") @db.Uuid
  /// Previous internship status — same value vocabulary as Internship.status
  oldStatus    String?     @map("old_status") @db.VarChar(50)
  /// New internship status — same value vocabulary as Internship.status
  newStatus    String?     @map("new_status") @db.VarChar(50)
  changedById  String?     @map("changed_by") @db.Uuid
  notes        String?
  createdAt    DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  changedBy    User?       @relation(fields: [changedById], references: [id], onDelete: Restrict)
  internship   Internship? @relation(fields: [internshipId], references: [id], onDelete: Restrict)

  @@index([internshipId])
  @@index([changedById])
  @@map("internship_status_histories")
}

model Attendance {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId         String                @map("internship_id") @db.Uuid
  attendanceDate       DateTime              @map("attendance_date") @db.Date
  checkInAt            DateTime?             @map("check_in_at") @db.Timestamp(6)
  checkOutAt           DateTime?             @map("check_out_at") @db.Timestamp(6)
  /// Check-in result — subset of attendance status vocabulary (PRESENT | LATE | PENDING_REVIEW | INVALID | ABSENT).
  /// Source: docs/05-state-machine.md §14/§18, docs/04-business-rules.md §19
  checkInStatus        String?               @map("check_in_status") @db.VarChar(30)
  /// Check-out result — subset of attendance status vocabulary (COMPLETED | PENDING_REVIEW | INVALID | ABSENT).
  /// Source: docs/05-state-machine.md §15/§18, docs/04-business-rules.md §19
  checkOutStatus       String?               @map("check_out_status") @db.VarChar(30)
  /// Attendance status (AttendanceStatus) — enforced via TS enum in service layer.
  /// Allowed values: PRESENT | LATE | COMPLETED | PENDING_REVIEW | INVALID | ABSENT
  /// Source: docs/04-business-rules.md §19, docs/05-state-machine.md §18
  attendanceStatus     String?               @map("attendance_status") @db.VarChar(30)
  totalWorkMinutes     Int?                  @map("total_work_minutes")
  notes                String?
  createdAt            DateTime?             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime?             @updatedAt @map("updated_at") @db.Timestamp(6)
  attendanceLogs       AttendanceLog[]
  attendanceOverrides  AttendanceOverride[]
  attendanceViolations AttendanceViolation[]
  internship           Internship            @relation(fields: [internshipId], references: [id])

  @@unique([internshipId, attendanceDate])
  @@map("attendances")
}

model AttendanceLog {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceId    String     @map("attendance_id") @db.Uuid
  /// Attendance log action — enforced via TS enum in service layer.
  /// Allowed values: CHECK_IN | CHECK_OUT (derived from attendance workflow docs/05-state-machine.md §14-15)
  action          String?    @db.VarChar(50)
  latitude        Decimal?   @db.Decimal(10, 7)
  longitude       Decimal?   @db.Decimal(10, 7)
  accuracyMeter   Decimal?   @map("accuracy_meter") @db.Decimal(10, 2)
  distanceMeter   Decimal?   @map("distance_meter") @db.Decimal(10, 2)
  insideGeofence  Boolean?   @map("inside_geofence")
  deviceName      String?    @map("device_name") @db.VarChar(255)
  platform        String?    @db.VarChar(100)
  browser         String?    @db.VarChar(100)
  ipAddress       String?    @map("ip_address") @db.VarChar(100)
  userAgent       String?    @map("user_agent")
  fakeGpsDetected Boolean    @default(false) @map("fake_gps_detected")
  photoFileId     String?    @map("photo_file_id") @db.Uuid
  createdAt       DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  attendance      Attendance @relation(fields: [attendanceId], references: [id])
  photoFile       File?      @relation("AttendancePhoto", fields: [photoFileId], references: [id], onDelete: Restrict)

  @@index([attendanceId])
  @@index([photoFileId])
  @@map("attendance_logs")
}

model AttendanceOverride {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceId   String     @map("attendance_id") @db.Uuid
  supervisorId   String     @map("supervisor_id") @db.Uuid
  /// Previous attendance status — same value vocabulary as Attendance.attendanceStatus
  previousStatus String?    @map("previous_status") @db.VarChar(50)
  /// New attendance status after override (per BR-OVERRIDE-001: PRESENT | INVALID)
  newStatus      String?    @map("new_status") @db.VarChar(50)
  reason         String?
  createdAt      DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  attendance     Attendance @relation(fields: [attendanceId], references: [id])
  supervisor     User       @relation(fields: [supervisorId], references: [id])

  @@index([attendanceId])
  @@index([supervisorId])
  @@map("attendance_overrides")
}

model AttendanceDevice {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceName   String?   @map("device_name") @db.VarChar(255)
  browser      String?   @db.VarChar(100)
  platform     String?   @db.VarChar(100)
  fingerprint  String?   @db.VarChar(255)
  firstLoginAt DateTime? @map("first_login_at") @db.Timestamp(6)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamp(6)
  isTrusted    Boolean   @default(false) @map("is_trusted")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("attendance_devices")
}

model AttendanceViolation {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceId  String     @map("attendance_id") @db.Uuid
  /// Violation type (ViolationType) — enforced via TS enum in service layer.
  /// Allowed values: FAKE_GPS | OUTSIDE_GEOFENCE | MULTIPLE_CHECK_IN | MULTIPLE_DEVICE_LOGIN | LATE_ATTENDANCE | EARLY_CHECK_OUT | DEVICE_MANIPULATION
  /// Source: docs/04-business-rules.md §21, docs/05-state-machine.md §20
  violationType String?    @map("violation_type") @db.VarChar(50)
  /// Severity level — enforced via TS enum in service layer (nilai tidak dieksplisitkan di docs)
  severity      String?    @db.VarChar(20)
  description   String?
  resolved      Boolean    @default(false)
  resolvedById  String?    @map("resolved_by") @db.Uuid
  resolvedAt    DateTime?  @map("resolved_at") @db.Timestamp(6)
  createdAt     DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  attendance    Attendance @relation(fields: [attendanceId], references: [id])
  resolvedBy    User?      @relation(fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([attendanceId])
  @@index([resolvedById])
  @@map("attendance_violations")
}

model AttendanceReminder {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId String     @map("internship_id") @db.Uuid
  /// Reminder type — enforced via TS enum in service layer (CHECK_IN | CHECK_OUT, derived from attendance workflow)
  reminderType String?    @map("reminder_type") @db.VarChar(30)
  scheduledAt  DateTime?  @map("scheduled_at") @db.Timestamp(6)
  sentAt       DateTime?  @map("sent_at") @db.Timestamp(6)
  /// Reminder delivery status — enforced via TS enum in service layer (PENDING | SENT, derived from scheduled_at/sent_at)
  status       String?    @db.VarChar(30)
  createdAt    DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  internship   Internship @relation(fields: [internshipId], references: [id])

  @@index([internshipId])
  @@map("attendance_reminders")
}

model File {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalName         String?                 @map("original_name") @db.VarChar(255)
  fileName             String?                 @map("file_name") @db.VarChar(255)
  mimeType             String?                 @map("mime_type") @db.VarChar(100)
  extension            String?                 @db.VarChar(20)
  size                 BigInt?
  storageProvider      String?                 @map("storage_provider") @db.VarChar(50)
  publicId             String?                 @map("public_id") @db.VarChar(255)
  url                  String?
  uploadedById         String?                 @map("uploaded_by") @db.Uuid
  createdAt            DateTime?               @default(now()) @map("created_at") @db.Timestamp(6)
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamp(6)
  attendancePhotos     AttendanceLog[]         @relation("AttendancePhoto")
  certificateTemplates CertificateTemplate[]
  certificates         Certificate[]           @relation("CertificateFile")
  uploadedBy           User?                   @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  applicationLetters   InternshipApplication[] @relation("IntroductionLetterFile")
  avatarUsers          User[]                  @relation("UserAvatar")

  @@index([uploadedById])
  @@map("files")
}

model Certificate {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId      String?              @unique @map("internship_id") @db.Uuid
  templateId        String?              @map("template_id") @db.Uuid
  certificateNumber String?              @unique @map("certificate_number") @db.VarChar(100)
  fileId            String?              @map("file_id") @db.Uuid
  generatedById     String?              @map("generated_by") @db.Uuid
  generatedAt       DateTime?            @map("generated_at") @db.Timestamp(6)
  verificationToken String?              @map("verification_token") @db.VarChar(255)
  createdAt         DateTime?            @default(now()) @map("created_at") @db.Timestamp(6)
  file              File?                @relation("CertificateFile", fields: [fileId], references: [id], onDelete: Restrict)
  generatedBy       User?                @relation("CertificateGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  internship        Internship?          @relation(fields: [internshipId], references: [id], onDelete: Restrict)
  template          CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([templateId])
  @@index([fileId])
  @@index([generatedById])
  @@map("certificates")
}

model NotificationType {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String         @unique @db.VarChar(100)
  name          String?        @db.VarChar(150)
  createdAt     DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)
  notifications Notification[]

  @@map("notification_types")
}

model Notification {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  typeId            String?            @map("type_id") @db.Uuid
  title             String?            @db.VarChar(255)
  message           String?
  isBroadcast       Boolean            @default(false) @map("is_broadcast")
  senderId          String?            @map("sender_id") @db.Uuid
  createdAt         DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  notificationReads NotificationRead[]
  sender            User?              @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Restrict)
  type              NotificationType?  @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([typeId])
  @@index([senderId])
  @@map("notifications")
}

model NotificationRead {
  notificationId String       @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  readAt         DateTime?    @map("read_at") @db.Timestamp(6)
  notification   Notification @relation(fields: [notificationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

model AuditLog {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  module    String?   @db.VarChar(100)
  action    String?   @db.VarChar(100)
  tableName String?   @map("table_name") @db.VarChar(100)
  recordId  String?   @map("record_id") @db.Uuid
  oldData   Json?     @map("old_data")
  newData   Json?     @map("new_data")
  ipAddress String?   @map("ip_address") @db.VarChar(100)
  userAgent String?   @map("user_agent")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("audit_logs")
}

model ActivityLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  activity    String?   @db.VarChar(255)
  description String?
  ipAddress   String?   @map("ip_address") @db.VarChar(100)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("activity_logs")
}
