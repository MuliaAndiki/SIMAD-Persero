model File {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalName                String?                       @map("original_name") @db.VarChar(255)
  fileName                    String?                       @map("file_name") @db.VarChar(255)
  mimeType                    String?                       @map("mime_type") @db.VarChar(100)
  extension                   String?                       @db.VarChar(20)
  size                        BigInt?
  storageProvider             String?                       @map("storage_provider") @db.VarChar(50)
  publicId                    String?                       @map("public_id") @db.VarChar(255)
  url                         String?
  uploadedById                String?                       @map("uploaded_by") @db.Uuid
  createdAt                   DateTime?                     @default(now()) @map("created_at") @db.Timestamp(6)
  deletedAt                   DateTime?                     @map("deleted_at") @db.Timestamp(6)
  attendancePhotos            AttendanceLog[]               @relation("AttendancePhoto")
  certificateTemplates        CertificateTemplate[]
  certificates                Certificate[]                 @relation("CertificateFile")
  uploadedBy                  User?                         @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  applicationLetters          InternshipApplication[]       @relation("IntroductionLetterFile")
  avatarUsers                 User[]                        @relation("UserAvatar")
  applicationDocuments        ApplicationDocument[]         @relation("ApplicationDocumentFile")
  correctionEvidenceFiles     AttendanceCorrectionRequest[] @relation("CorrectionEvidenceFile")
  certificateSignatures       CertificateSetting[]          @relation("CertificateSettingSignature")
  certificateStamps           CertificateSetting[]          @relation("CertificateSettingStamp")
  certificateSettingTemplates CertificateSetting[]          @relation("CertificateSettingTemplate")

  @@index([uploadedById])
  @@map("files")
}

model InternshipEvaluation {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId        String    @unique @map("internship_id") @db.Uuid
  supervisorId        String    @map("supervisor_id") @db.Uuid
  disciplineScore     Decimal   @default(0) @map("discipline_score") @db.Decimal(5, 2)
  responsibilityScore Decimal   @default(0) @map("responsibility_score") @db.Decimal(5, 2)
  teamworkScore       Decimal   @default(0) @map("teamwork_score") @db.Decimal(5, 2)
  communicationScore  Decimal   @default(0) @map("communication_score") @db.Decimal(5, 2)
  technicalScore      Decimal   @default(0) @map("technical_score") @db.Decimal(5, 2)
  initiativeScore     Decimal   @default(0) @map("initiative_score") @db.Decimal(5, 2)
  finalScore          Decimal   @default(0) @map("final_score") @db.Decimal(5, 2)
  grade               String?   @db.VarChar(10)
  comments            String?
  /// Status — DRAFT | SUBMITTED | REVISION_REQUIRED | FINAL
  status              String    @default("DRAFT") @db.VarChar(50)
  submittedAt         DateTime? @map("submitted_at") @db.Timestamp(6)
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  internship   Internship    @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  supervisor   User          @relation("EvaluationSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  certificates Certificate[]

  @@index([supervisorId, status])
  @@map("internship_evaluations")
}

model Certificate {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId      String?               @unique @map("internship_id") @db.Uuid
  templateId        String?               @map("template_id") @db.Uuid
  certificateNumber String?               @unique @map("certificate_number") @db.VarChar(100)
  fileId            String?               @map("file_id") @db.Uuid
  generatedById     String?               @map("generated_by") @db.Uuid
  generatedAt       DateTime?             @map("generated_at") @db.Timestamp(6)
  verificationToken String?               @map("verification_token") @db.VarChar(255)
  /// Approval status — WAITING_EVALUATION | WAITING_APPROVAL | APPROVED | GENERATED | REJECTED
  approvalStatus    String?               @default("WAITING_EVALUATION") @map("approval_status") @db.VarChar(50)
  approvedById      String?               @map("approved_by_id") @db.Uuid
  approvedAt        DateTime?             @map("approved_at") @db.Timestamp(6)
  rejectionReason   String?               @map("rejection_reason")
  evaluationId      String?               @map("evaluation_id") @db.Uuid
  createdAt         DateTime?             @default(now()) @map("created_at") @db.Timestamp(6)
  file              File?                 @relation("CertificateFile", fields: [fileId], references: [id], onDelete: Restrict)
  generatedBy       User?                 @relation("CertificateGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  approvedBy        User?                 @relation("CertificateApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  internship        Internship?           @relation(fields: [internshipId], references: [id], onDelete: Restrict)
  template          CertificateTemplate?  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  evaluation        InternshipEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: Restrict)

  @@index([templateId])
  @@index([fileId])
  @@index([generatedById])
  @@index([approvedById])
  @@index([evaluationId])
  @@map("certificates")
}

