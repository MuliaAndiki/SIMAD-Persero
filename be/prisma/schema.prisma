generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName                  String                        @map("full_name") @db.VarChar(150)
  email                     String                        @unique @db.VarChar(150)
  password                  String?                       @db.VarChar
  avatarFileId              String?                       @map("avatar_file_id") @db.Uuid
  emailVerified             Boolean                       @default(false) @map("email_verified")
  emailVerifiedAt           DateTime?                     @map("email_verified_at") @db.Timestamp(6)
  lastLoginAt               DateTime?                     @map("last_login_at") @db.Timestamp(6)
  isActive                  Boolean                       @default(true) @map("is_active")
  createdAt                 DateTime?                     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime?                     @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt                 DateTime?                     @map("deleted_at") @db.Timestamp(6)
  departmentId              String?                       @map("department_id") @db.Uuid
  officeId                  String?                       @map("office_id") @db.Uuid
  department                Department?                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  officeLocation            OfficeLocation?               @relation(fields: [officeId], references: [id], onDelete: Restrict)
  activityLogs              ActivityLog[]
  trustedDevices            AttendanceDevice[]
  overriddenAttendances     AttendanceOverride[]
  resolvedViolations        AttendanceViolation[]
  auditLogs                 AuditLog[]
  generatedCertificates     Certificate[]                 @relation("CertificateGeneratedBy")
  approvedCertificates      Certificate[]                 @relation("CertificateApprovedBy")
  uploadedFiles             File[]                        @relation("FileUploadedBy")
  internProfile             InternProfile?
  reviewedApplications      InternshipApplication[]       @relation("ReviewedBy")
  changedInternshipStatuses InternshipStatusHistory[]
  readNotifications         NotificationRead[]
  sentNotifications         Notification[]                @relation("NotificationSender")
  refreshTokens             RefreshToken[]
  createdSupervisors        SupervisorAssignment[]        @relation("SupervisorAssignedBy")
  assignedSupervisors       SupervisorAssignment[]        @relation("SupervisorUser")
  assignedUserRoles         UserRole[]                    @relation("UserRoleAssignedBy")
  userRoles                 UserRole[]                    @relation("UserRoleUser")
  avatarFile                File?                         @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: Restrict)
  createdQuotas             InternshipQuota[]             @relation("QuotaCreatedBy")
  requestedCorrections      AttendanceCorrectionRequest[] @relation("CorrectionRequestedBy")
  supervisedCorrections     AttendanceCorrectionRequest[] @relation("CorrectionSupervisor")
  reviewedCorrections       AttendanceCorrectionRequest[] @relation("CorrectionReviewedBy")
  supervisedEvaluations     InternshipEvaluation[]        @relation("EvaluationSupervisor")
  createdGuides             GuideContent[]                @relation("GuideCreatedBy")

  @@index([avatarFileId])
  @@map("users")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique @db.VarChar(50)
  name            String?          @db.VarChar(100)
  description     String?
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?        @updatedAt @map("updated_at") @db.Timestamp(6)
  rolePermissions RolePermission[]
  userRoles       UserRole[]       @relation("UserRoleRole")

  @@map("roles")
}

model UserRole {
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedAt   DateTime? @map("assigned_at") @db.Timestamp(6)
  assignedById String?   @map("assigned_by") @db.Uuid
  assignedBy   User?     @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  role         Role      @relation("UserRoleRole", fields: [roleId], references: [id])
  user         User      @relation("UserRoleUser", fields: [userId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String?          @unique @db.VarChar(100)
  name            String?          @db.VarChar
  description     String?
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  token     String?
  expiresAt DateTime? @map("expires_at") @db.Timestamp(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("refresh_tokens")
}

model EducationLevel {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String?       @unique @db.VarChar(20)
  name         String?       @db.VarChar(100)
  createdAt    DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  institutions Institution[]

  @@map("education_levels")
}

model Institution {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  educationLevelId  String?            @map("education_level_id") @db.Uuid
  name              String?            @db.VarChar(200)
  shortName         String?            @map("short_name") @db.VarChar(100)
  province          String?            @db.VarChar(100)
  logo              String?            @map("logo")
  city              String?            @db.VarChar(100)
  createdAt         DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime?          @updatedAt @map("updated_at") @db.Timestamp(6)
  institutionMajors InstitutionMajor[]
  educationLevel    EducationLevel?    @relation(fields: [educationLevelId], references: [id], onDelete: Restrict)
  internProfiles    InternProfile[]

  @@index([educationLevelId])
  @@map("institutions")
}

model InstitutionMajor {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId  String?         @map("institution_id") @db.Uuid
  name           String?         @db.VarChar(150)
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  institution    Institution?    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  internProfiles InternProfile[]

  @@index([institutionId])
  @@map("institution_majors")
}

model Skill {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String?              @db.VarChar(100)
  category            String?              @db.VarChar(100)
  createdAt           DateTime?            @default(now()) @map("created_at") @db.Timestamp(6)
  internProfileSkills InternProfileSkill[]

  @@map("skills")
}

model Department {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String            @unique @db.VarChar(50)
  name             String?           @db.VarChar(150)
  description      String?
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime?         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime?         @updatedAt @map("updated_at") @db.Timestamp(6)
  internships      Internship[]
  officeLocations  OfficeLocation[]
  users            User[]
  quotaAllocations QuotaDepartmentAllocation[]

  @@map("departments")
}

model OfficeLocation {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String?                 @db.VarChar(150)
  address                String?
  latitude               Decimal?                @db.Decimal
  longitude              Decimal?                @db.Decimal
  radiusMeter            Int?                    @map("radius_meter")
  createdAt              DateTime?               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime?               @updatedAt @map("updated_at") @db.Timestamp(6)
  departments            Department[]
  attendanceSettings     AttendanceSetting[]
  internships            Internship[]
  internshipApplications InternshipApplication[]
  users                  User[]
  internshipQuotas       InternshipQuota[]
  certificateSettings    CertificateSetting[]

  @@map("office_locations")
}

model AttendanceSetting {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeLocationId String?         @map("office_location_id") @db.Uuid
  checkInStart     DateTime?       @map("check_in_start") @db.Time(6)
  checkInEnd       DateTime?       @map("check_in_end") @db.Time(6)
  checkOutStart    DateTime?       @map("check_out_start") @db.Time(6)
  checkOutEnd      DateTime?       @map("check_out_end") @db.Time(6)
  lateAfter        DateTime?       @map("late_after") @db.Time(6)
  allowWeekend     Boolean         @default(false) @map("allow_weekend")
  createdAt        DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime?       @updatedAt @map("updated_at") @db.Timestamp(6)
  officeLocation   OfficeLocation? @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)

  @@index([officeLocationId])
  @@map("attendance_settings")
}

model CertificateTemplate {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?       @db.VarChar(150)
  templateFileId String?       @map("template_file_id") @db.Uuid
  isDefault      Boolean?      @map("is_default")
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?     @updatedAt @map("updated_at") @db.Timestamp(6)
  templateFile   File?         @relation(fields: [templateFileId], references: [id], onDelete: Restrict)
  certificates   Certificate[]

  @@index([templateFileId])
  @@map("certificate_templates")
}

model CertificateSetting {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeLocationId        String?   @unique @map("office_location_id") @db.Uuid
  signerName              String    @map("signer_name") @db.VarChar(150)
  signerRole              String    @map("signer_role") @db.VarChar(150)
  signatureFileId         String?   @map("signature_file_id") @db.Uuid
  stampFileId             String?   @map("stamp_file_id") @db.Uuid
  templateFileId          String?   @map("template_file_id") @db.Uuid
  certificateNumberFormat String    @default("SIMAD/{OFFICE_CODE}/{YEAR}/{NUM}") @map("certificate_number_format") @db.VarChar(100)
  isActive                Boolean   @default(true) @map("is_active")
  createdAt               DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  officeLocation OfficeLocation? @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)
  signatureFile  File?           @relation("CertificateSettingSignature", fields: [signatureFileId], references: [id], onDelete: Restrict)
  stampFile      File?           @relation("CertificateSettingStamp", fields: [stampFileId], references: [id], onDelete: Restrict)
  templateFile   File?           @relation("CertificateSettingTemplate", fields: [templateFileId], references: [id], onDelete: Restrict)

  @@map("certificate_settings")
}

model InternProfile {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                  @unique @map("user_id") @db.Uuid
  studentNumber    String                  @map("student_number") @db.VarChar(100)
  institutionId    String                  @map("institution_id") @db.Uuid
  majorId          String                  @map("major_id") @db.Uuid
  phone            String                  @db.VarChar(30)
  emergencyContact String?                 @map("emergency_contact") @db.VarChar(30)
  address          String?
  birthPlace       String?                 @map("birth_place") @db.VarChar(100)
  birthDate        DateTime?               @map("birth_date") @db.Date
  gender           String?                 @db.VarChar(20)
  bio              String?
  createdAt        DateTime?               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime?               @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamp(6)
  profileSkills    InternProfileSkill[]
  institution      Institution             @relation(fields: [institutionId], references: [id])
  major            InstitutionMajor        @relation(fields: [majorId], references: [id])
  user             User                    @relation(fields: [userId], references: [id])
  applications     InternshipApplication[]
  internships      Internship[]

  @@index([institutionId])
  @@index([majorId])
  @@map("intern_profiles")
}

model InternProfileSkill {
  internProfileId String        @map("intern_profile_id") @db.Uuid
  skillId         String        @map("skill_id") @db.Uuid
  proficiency     String?       @db.VarChar(30)
  createdAt       DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  internProfile   InternProfile @relation(fields: [internProfileId], references: [id])
  skill           Skill         @relation(fields: [skillId], references: [id])

  @@id([internProfileId, skillId])
  @@index([skillId])
  @@map("intern_profile_skills")
}

model InternshipApplication {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internProfileId          String                @map("intern_profile_id") @db.Uuid
  applicationNumber        String?               @unique @map("application_number") @db.VarChar(100)
  introductionLetterFileId String                @map("introduction_letter_file_id") @db.Uuid
  requestedStartDate       DateTime?             @map("requested_start_date") @db.Date
  requestedEndDate         DateTime?             @map("requested_end_date") @db.Date
  actualStartDate          DateTime?             @map("actual_start_date") @db.Date
  actualEndDate            DateTime?             @map("actual_end_date") @db.Date
  motivation               String?
  officeLocationId         String?               @map("office_location_id") @db.Uuid
  /// Application status (ApplicationStatus) — enforced via TS enum in service layer.
  /// Allowed values: DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | RESUBMITTED
  status                   String?               @db.VarChar(50)
  reviewedById             String?               @map("reviewed_by") @db.Uuid
  reviewedAt               DateTime?             @map("reviewed_at") @db.Timestamp(6)
  rejectionReason          String?               @map("rejection_reason")
  createdAt                DateTime?             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime?             @updatedAt @map("updated_at") @db.Timestamp(6)
  internProfile            InternProfile         @relation(fields: [internProfileId], references: [id])
  introductionLetterFile   File                  @relation("IntroductionLetterFile", fields: [introductionLetterFileId], references: [id])
  reviewedBy               User?                 @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  officeLocation           OfficeLocation?       @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)
  internship               Internship?
  documents                ApplicationDocument[]

  @@index([internProfileId])
  @@index([introductionLetterFileId])
  @@index([reviewedById])
  @@index([officeLocationId])
  @@map("internship_applications")
}

model ApplicationDocument {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  fileId        String    @map("file_id") @db.Uuid
  /// Document type — CV | FACULTY_REQUEST_LETTER | OTHER
  type          String    @db.VarChar(50)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  application InternshipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  file        File                  @relation("ApplicationDocumentFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([applicationId, type])
  @@index([fileId])
  @@map("application_documents")
}

model InternshipQuota {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeLocationId      String                      @unique @map("office_location_id") @db.Uuid
  totalCapacity         Int                         @default(0) @map("total_capacity")
  isActive              Boolean                     @default(true) @map("is_active")
  notes                 String?
  createdBy             String?                     @map("created_by") @db.Uuid
  createdAt             DateTime?                   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime?                   @updatedAt @map("updated_at") @db.Timestamp(6)

  officeLocation        OfficeLocation              @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)
  createdByUser         User?                       @relation("QuotaCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  departmentAllocations QuotaDepartmentAllocation[]
  internships           Internship[]

  @@map("internship_quotas")
}

model QuotaDepartmentAllocation {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotaId      String          @map("quota_id") @db.Uuid
  departmentId String          @map("department_id") @db.Uuid
  capacity     Int
  notes        String?
  createdAt    DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?       @updatedAt @map("updated_at") @db.Timestamp(6)

  quota        InternshipQuota @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([quotaId, departmentId])
  @@index([departmentId])
  @@map("quota_department_allocations")
}

model Internship {
  id                    String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId         String?                       @unique @map("application_id") @db.Uuid
  internProfileId       String?                       @map("intern_profile_id") @db.Uuid
  departmentId          String?                       @map("department_id") @db.Uuid
  officeLocationId      String?                       @map("office_location_id") @db.Uuid
  quotaId               String?                       @map("quota_id") @db.Uuid
  actualStartDate       DateTime?                     @map("actual_start_date") @db.Date
  actualEndDate         DateTime?                     @map("actual_end_date") @db.Date
  /// Internship status (InternshipStatus) — PENDING | ACTIVE | COMPLETED | CERTIFICATE_GENERATED | ARCHIVED
  status                String?                       @db.VarChar(50)
  onboardingCompleted   Boolean                       @default(false) @map("onboarding_completed")
  completedAt           DateTime?                     @map("completed_at") @db.Timestamp(6)
  createdAt             DateTime?                     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime?                     @updatedAt @map("updated_at") @db.Timestamp(6)
  reminders             AttendanceReminder[]
  attendances           Attendance[]
  certificate           Certificate?
  statusHistories       InternshipStatusHistory[]
  application           InternshipApplication?        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  department            Department?                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  internProfile         InternProfile?                @relation(fields: [internProfileId], references: [id], onDelete: Restrict)
  officeLocation        OfficeLocation?               @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)
  quota                 InternshipQuota?              @relation(fields: [quotaId], references: [id], onDelete: Restrict)
  onboardingHistories   OnboardingHistory[]
  supervisorAssignments SupervisorAssignment[]
  correctionRequests    AttendanceCorrectionRequest[]
  evaluation            InternshipEvaluation?

  @@index([internProfileId])
  @@index([departmentId])
  @@index([officeLocationId])
  @@index([quotaId])
  @@map("internships")
}

model SupervisorAssignment {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId String?     @map("internship_id") @db.Uuid
  supervisorId String?     @map("supervisor_id") @db.Uuid
  assignedById String?     @map("assigned_by") @db.Uuid
  assignedAt   DateTime?   @map("assigned_at") @db.Timestamp(6)
  endedAt      DateTime?   @map("ended_at") @db.Timestamp(6)
  isActive     Boolean     @default(true) @map("is_active")
  assignedBy   User?       @relation("SupervisorAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  internship   Internship? @relation(fields: [internshipId], references: [id], onDelete: Restrict)
  supervisor   User?       @relation("SupervisorUser", fields: [supervisorId], references: [id], onDelete: Restrict)

  @@index([internshipId])
  @@index([supervisorId])
  @@index([assignedById])
  @@map("supervisor_assignments")
}

model OnboardingHistory {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId String?     @map("internship_id") @db.Uuid
  accepted     Boolean?
  acceptedAt   DateTime?   @map("accepted_at") @db.Timestamp(6)
  ipAddress    String?     @map("ip_address") @db.VarChar(100)
  userAgent    String?     @map("user_agent")
  internship   Internship? @relation(fields: [internshipId], references: [id], onDelete: Restrict)

  @@index([internshipId])
  @@map("onboarding_histories")
}

model InternshipStatusHistory {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId String?     @map("internship_id") @db.Uuid
  oldStatus    String?     @map("old_status") @db.VarChar(50)
  newStatus    String?     @map("new_status") @db.VarChar(50)
  changedById  String?     @map("changed_by") @db.Uuid
  notes        String?
  createdAt    DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  changedBy    User?       @relation(fields: [changedById], references: [id], onDelete: Restrict)
  internship   Internship? @relation(fields: [internshipId], references: [id], onDelete: Restrict)

  @@index([internshipId])
  @@index([changedById])
  @@map("internship_status_histories")
}

model Attendance {
  id                   String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId         String                        @map("internship_id") @db.Uuid
  attendanceDate       DateTime                      @map("attendance_date") @db.Date
  checkInAt            DateTime?                     @map("check_in_at") @db.Timestamp(6)
  checkOutAt           DateTime?                     @map("check_out_at") @db.Timestamp(6)
  checkInStatus        String?                       @map("check_in_status") @db.VarChar(30)
  checkOutStatus       String?                       @map("check_out_status") @db.VarChar(30)
  attendanceStatus     String?                       @map("attendance_status") @db.VarChar(30)
  totalWorkMinutes     Int?                          @map("total_work_minutes")
  notes                String?
  createdAt            DateTime?                     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime?                     @updatedAt @map("updated_at") @db.Timestamp(6)
  attendanceLogs       AttendanceLog[]
  attendanceOverrides  AttendanceOverride[]
  attendanceViolations AttendanceViolation[]
  correctionRequests   AttendanceCorrectionRequest[]
  internship           Internship                    @relation(fields: [internshipId], references: [id])

  @@unique([internshipId, attendanceDate])
  @@map("attendances")
}

model AttendanceLog {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceId    String     @map("attendance_id") @db.Uuid
  action          String?    @db.VarChar(50)
  latitude        Decimal?   @db.Decimal(10, 7)
  longitude       Decimal?   @db.Decimal(10, 7)
  accuracyMeter   Decimal?   @map("accuracy_meter") @db.Decimal(10, 2)
  distanceMeter   Decimal?   @map("distance_meter") @db.Decimal(10, 2)
  insideGeofence  Boolean?   @map("inside_geofence")
  deviceName      String?    @map("device_name") @db.VarChar(255)
  platform        String?    @db.VarChar(100)
  browser         String?    @db.VarChar(100)
  ipAddress       String?    @map("ip_address") @db.VarChar(100)
  userAgent       String?    @map("user_agent")
  fakeGpsDetected Boolean    @default(false) @map("fake_gps_detected")
  photoFileId     String?    @map("photo_file_id") @db.Uuid
  createdAt       DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  attendance      Attendance @relation(fields: [attendanceId], references: [id])
  photoFile       File?      @relation("AttendancePhoto", fields: [photoFileId], references: [id], onDelete: Restrict)

  @@index([attendanceId])
  @@index([photoFileId])
  @@map("attendance_logs")
}

model AttendanceCorrectionRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceId      String    @map("attendance_id") @db.Uuid
  internshipId      String    @map("internship_id") @db.Uuid
  internId          String    @map("intern_id") @db.Uuid
  supervisorId      String?   @map("supervisor_id") @db.Uuid
  /// Correction type — CHECK_IN | CHECK_OUT | BOTH | INVALID_OVERRIDE
  correctionType    String    @map("correction_type") @db.VarChar(50)
  requestedCheckIn  DateTime? @map("requested_check_in") @db.Timestamp(6)
  requestedCheckOut DateTime? @map("requested_check_out") @db.Timestamp(6)
  reason            String
  evidenceFileId    String?   @map("evidence_file_id") @db.Uuid
  /// Status — PENDING | APPROVED | REJECTED | CANCELLED
  status            String    @default("PENDING") @db.VarChar(50)
  supervisorNotes   String?   @map("supervisor_notes")
  reviewedById      String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamp(6)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  intern       User       @relation("CorrectionRequestedBy", fields: [internId], references: [id], onDelete: Restrict)
  supervisor   User?      @relation("CorrectionSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  reviewedBy   User?      @relation("CorrectionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  evidenceFile File?      @relation("CorrectionEvidenceFile", fields: [evidenceFileId], references: [id], onDelete: SetNull)

  @@index([internshipId, status])
  @@index([supervisorId, status])
  @@index([internId])
  @@map("attendance_correction_requests")
}

