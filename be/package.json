    "@types/node": "^22.10.5",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vercel/node": "^3.2.27",
    "bun-types": "^1.3.10",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
